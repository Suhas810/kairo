# Kairo Project Environment Configuration

# Backend API Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Vite variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Supabase Secrets (Never expose to frontend!)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Nebius Token Factory / NVIDIA Nemotron Inference
NEBIUS_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# GitHub Integration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Runner & Sandbox Isolation
EXECUTION_TIMEOUT_SECONDS=120
MAX_CONCURRENT_EXECUTIONS=2
EXECUTION_ENABLED=true
SANDBOX_FALLBACK_LOCAL=true

