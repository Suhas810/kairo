# Kairo Backend Environment Configuration
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1

# Allowed frontend origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000

# Supabase PostgreSQL & Auth (Required for real persistence & token verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=

# Nebius Token Factory / NVIDIA Nemotron (Required for live agent inference)
# Endpoint: https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# GitHub OAuth / App Integration (Optional for live repo sync)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Isolated Sandbox & Worker Execution Settings
EXECUTION_TIMEOUT_SECONDS=120
MAX_CONCURRENT_EXECUTIONS=2
EXECUTION_ENABLED=true
SANDBOX_FALLBACK_LOCAL=true

